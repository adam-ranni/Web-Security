FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN pip install --no-cache-dir \
    Flask==3.1.3 Werkzeug==3.1.9 lxml==6.1.3

RUN useradd --create-home --uid 10001 bookshop

COPY app.py ./
COPY templates/ ./templates/
COPY static/ ./static/

RUN chown -R bookshop:bookshop /app

USER bookshop

EXPOSE 5005

CMD ["python", "-c", "import app; app.init_user_db(); app.init_shop_db(); app.init_race_lab_db(); app.app.run(host='0.0.0.0', port=5005, debug=False, use_reloader=False)"]